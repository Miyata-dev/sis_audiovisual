generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Attendance {
  id         Int      @id @default(autoincrement())
  userId     Int
  sessionId  Int
  timeJoined DateTime @default(now())
  Session    Session  @relation(fields: [sessionId], references: [id])
  User       User     @relation(fields: [userId], references: [id])

  @@unique([userId, sessionId])
}

model MediaFile {
  id         Int      @id @default(autoincrement())
  filename   String
  fileType   String
  storageUrl String
  sessionId  Int
  uploadedAt DateTime @default(now())
  Session    Session  @relation(fields: [sessionId], references: [id])
}

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique
  User User[]
}

model Session {
  id               Int               @id @default(autoincrement())
  title            String
  date             DateTime          @default(now())
  status           String
  theme            String?
  duration         String?
  videoUrl         String?
  thumbnailUrl     String?
  actaUrl          String?
  transcriptionUrl String?
  Attendance       Attendance[]
  MediaFile        MediaFile[]
  SpeakingRequest  SpeakingRequest[]
  VotingEvent      VotingEvent[]
}

model SpeakingRequest {
  id          Int      @id @default(autoincrement())
  userId      Int
  sessionId   Int
  status      String
  requestedAt DateTime @default(now())
  Session     Session  @relation(fields: [sessionId], references: [id])
  User        User     @relation(fields: [userId], references: [id])
}

model User {
  id              Int               @id @default(autoincrement())
  email           String            @unique
  password        String
  name            String
  roleId          Int
  Attendance      Attendance[]
  SpeakingRequest SpeakingRequest[]
  Role            Role              @relation(fields: [roleId], references: [id])
  Vote            Vote[]
}

model Vote {
  id            Int         @id @default(autoincrement())
  userId        Int
  votingEventId Int
  option        String
  timestamp     DateTime    @default(now())
  User          User        @relation(fields: [userId], references: [id])
  VotingEvent   VotingEvent @relation(fields: [votingEventId], references: [id])

  @@unique([userId, votingEventId])
}

model VotingEvent {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  sessionId   Int
  status      String
  Vote        Vote[]
  Session     Session @relation(fields: [sessionId], references: [id])
}
